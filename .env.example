# AIS Account Credentials
AIS_EMAIL=your-email@example.com
AIS_PASSWORD=your-password

# Facility ID for Addis Ababa (HOW TO FIND):
#   1. Log in → go to Schedule/Reschedule appointment page
#   2. Right-click the location/consulate dropdown → Inspect
#   3. Look for <option value="???">Addis Ababa</option>
#   4. That number is your FACILITY_ID
FACILITY_ID=95

# Twilio Configuration (https://console.twilio.com)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_FROM_NUMBER=+1XXXXXXXXXX
TWILIO_TO_NUMBER=+1XXXXXXXXXX

# Check interval in seconds (don't go below 120 — site will block you)
CHECK_INTERVAL=300
