# Copy to .env and fill in your values:
#   cp .env.example .env
#
# ─────────────────────────────────────────────────────────────────
# AIS_ACCOUNT
# ─────────────────────────────────────────────────────────────────

# Required. Your AIS login email.
AIS_EMAIL=your-email@example.com

# Required. Your AIS password.
AIS_PASSWORD=your-password

# Schedule ID (priority: flag → SCHEDULE_ID env). Find it in your AIS URL after login: .../schedule/XXXXXXXX/...
SCHEDULE_ID=0

# Paid mode: required. The numeric ID for the Addis Ababa consulate.
# Find it by inspecting the location dropdown on the reschedule page:
#   <option value="???">Addis Ababa</option>
FACILITY_ID=95

# ─────────────────────────────────────────────────────────────────
# TWILIO — https://console.twilio.com
# ─────────────────────────────────────────────────────────────────

# Required. Account SID from the Twilio console.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Required. Auth token from the Twilio console.
TWILIO_AUTH_TOKEN=your_auth_token

# Required. Your Twilio phone number (sender).
TWILIO_FROM_NUMBER=+1XXXXXXXXXX

# Required. Your personal number (recipient).
TWILIO_TO_NUMBER=+1XXXXXXXXXX

# ─────────────────────────────────────────────────────────────────
# RUNNER
# ─────────────────────────────────────────────────────────────────

# Optional. Seconds between checks. Default 300. Don't go below 120 or the site may block you.
CHECK_INTERVAL=300
