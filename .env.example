# Copy to .env and fill in your values:
#   cp .env.example .env
#
# ─────────────────────────────────────────────────────────────────
# AIS_ACCOUNT
# ─────────────────────────────────────────────────────────────────

# Required. Your AIS login email.
AIS_EMAIL=your-email@example.com

# Required. Your AIS password.
AIS_PASSWORD=your-password

# Required. Schedule ID from your AIS URL after login: .../schedule/XXXXXXXX/...
SCHEDULE_ID=0

# Required when fee is paid. The numeric ID for the Addis Ababa consulate.
# Find it by inspecting the location dropdown on the reschedule page:
#   <option value="???">Addis Ababa</option>
FACILITY_ID=0

# ─────────────────────────────────────────────────────────────────
# TELEGRAM BOT — https://t.me/BotFather
# ─────────────────────────────────────────────────────────────────

# Required. Telegram Bot token from @BotFather.
# 1. Open Telegram and search for @BotFather
# 2. Send /start, then /newbot
# 3. Follow prompts to create a bot
# 4. Copy the bot token provided (format: 123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11)
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Required. Target Telegram channel. The bot must be an administrator
# of the channel with permission to post messages.
#
# Numeric id is usually -100…. Get it by forwarding any message from the channel to
# @userinfobot (it replies with the chat id).
#
# Or via API: make the bot an admin, post once in the channel, then GET
# https://api.telegram.org/bot{YOUR_BOT_TOKEN}/getUpdates and read
# "channel_post" → "chat" → "id". Test:
# https://api.telegram.org/bot{YOUR_BOT_TOKEN}/sendMessage?chat_id={YOUR_CHANNEL_ID}&text=Hello%20World
TELEGRAM_CHANNEL_ID=@your_channel_or_-100id

# Optional. Comma-separated Telegram chat IDs to ping directly between 23:00–06:00.
# The bot must have received /start from each user (or be added to the group).
# Configure Telegram's notification settings on those chats to ring loudly.
# Example: NIGHT_PING_TARGETS=123456789,-987654321
NIGHT_PING_TARGETS=

# ─────────────────────────────────────────────────────────────────
# RUNNER
# ─────────────────────────────────────────────────────────────────

# Optional. Seconds between checks. Default 300. Don't go below 120 or the site may block you.
CHECK_INTERVAL=300
